[Unit]
Description=Stable Audio 3.0 Medium (saudio, gradio + REST, port 7864)
# Ollama と VRAM を食い合うので、Ollama のユニットには依存させない（入口ページ tools/portal が起動前に
# Ollama のモデルを降ろす）。GPU を使うほかのサービスとも同時には載せない。Conflicts= により、こちらを
# start すると systemd がほかの 10 個を止める（逆も同じ。Conflicts= は双方向に効く）。
Conflicts=hunyuan3d.service pixal3d.service comfyui.service strata.service strata-coder.service strata-official.service strata-official-iq3s.service strata-swift.service audiocraft.service qwen3-tts.service
# Conflicts= だけでは止める順番が決まらない。順序は一方向の鎖（こちらがほかの 10 個の後ろ）にして、
# ほかの 10 個のユニットの側には After=stable-audio.service を書かない（両側に書くと順序が輪になる）。
After=network.target hunyuan3d.service pixal3d.service comfyui.service strata.service strata-coder.service strata-official.service strata-official-iq3s.service strata-swift.service audiocraft.service qwen3-tts.service

[Service]
Type=simple
# リポジトリのパスは、setup-server.sh が雛形の印をこの機体の絶対パスに置き換えて書く（scripts/lib/render-unit.sh）。手で写すときは自分で置き換える。
WorkingDirectory=@REPO_ROOT@/tools/stable-audio
# 先頭の "-" はファイルが無くてもエラーにしない意味。今のところ読む変数は無い（将来の設定用）。
EnvironmentFile=-%h/.config/stable-audio/stable-audio.env
ExecStart=@REPO_ROOT@/tools/stable-audio/run-stable-audio serve
Restart=on-failure
RestartSec=5
# 導入が済んでいない（重みが無いなど）ときの終了コード 78 では再起動しない（saudio/cli.py の SETUP_INCOMPLETE_EXIT）。
RestartPreventExitStatus=78
# 重み 9.2 GB と文章の符号化器 1.2 GB の読み込み（冷えたディスクキャッシュではさらに長い）。
TimeoutStartSec=600
# RAM の安全弁。上限に当たったサービスだけがカーネルに落とされ、デスクトップは巻き込まれない。
# 既定は MemoryHigh=16G / MemoryMax=20G。2026-11-23 の実測で cgroup の memory.peak は 9.70 GiB（重み 9.2 GB を f32 で読む読み込み中。生成では増えない）。
# 約 1.6 倍の余裕を見る。
# 運用中の値は入口ページ（tools/portal）から変える。変えた値は systemctl set-property の
# drop-in（~/.config/systemd/user.control/）に入り、このファイルの値より優先される。
MemoryHigh=16G
MemoryMax=20G

[Install]
WantedBy=default.target
